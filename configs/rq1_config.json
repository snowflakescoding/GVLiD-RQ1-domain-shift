    "mobilenet_v3_small": {"lr": 0.0005, "wd": 0.01,   "epochs": 40, "patience": 10, "weights": "torchvision MobileNet_V3_Small_Weights.IMAGENET1K_V1"},
    "convnext_tiny":      {"lr": 0.0001, "wd": 0.05,   "epochs": 30, "patience": 8,  "weights": "torchvision ConvNeXt_Tiny_Weights.IMAGENET1K_V1"}
